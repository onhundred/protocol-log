// Merged by scripts/update-from-template.mjs: name, vars, routes, account_id and resource ids
// come from this install, everything else from the template.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onhundred-protocol",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onhundred-log",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "onhundred-log-backups"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WRITER",
        "class_name": "Writer"
      }
    ]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Writer"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "vars": {
    "PUBLISH": "false",
    "LANGUAGES": "en"
  },
  "observability": {
    "enabled": true
  }
}
